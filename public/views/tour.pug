extends base

block append head
  style.
    .section-header {
      position: relative;
      height: 80vh;
      clip-path: polygon(0 0, 100% 0, 100% 83vh, 0 100%);
      background: linear-gradient(to right bottom, rgba(11, 15, 25, 0.8), rgba(21, 28, 44, 0.9)),
                  url('/img/tours/tour-5-cover.jpg') center/cover no-repeat;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: var(--text-main);
      border-bottom: 1px solid var(--border);
    }

    .heading-box {
      max-width: 80rem;
      padding: 0 3rem;
    }

    .heading-primary {
      font-size: 4rem;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 1px;
      line-height: 1.2;
      margin-bottom: 2rem;
      color: #fff;
    }

    .heading-box__group {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 3rem;
      font-size: 1.1rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .heading-box__detail {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      color: var(--accent);
    }

    .heading-box__icon {
      height: 1.5rem;
      width: 1.5rem;
      fill: var(--accent);
    }

    .section-description {
      background-color: var(--bg-body);
      margin-top: -9vw;
      padding: 12vw 8vw 8vw;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }

    .heading-secondary {
      font-size: 1.6rem;
      text-transform: uppercase;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: 0.05em;
      margin-bottom: 2rem;
    }

    .overview-box {
      background-color: var(--bg-surface);
      padding: 3.5rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }

    .overview-box__group:not(:last-child) {
      margin-bottom: 3.5rem;
    }

    .overview-box__detail {
      display: flex;
      align-items: center;
      padding: 1rem 0;
      border-bottom: 1px solid var(--border);
    }

    .overview-box__detail:last-child {
      border-bottom: none;
    }

    .overview-box__icon {
      height: 1.5rem;
      width: 1.5rem;
      fill: var(--accent);
      margin-right: 1.2rem;
    }

    .overview-box__label {
      font-weight: 700;
      margin-right: 1rem;
      text-transform: uppercase;
      font-size: 0.85rem;
      color: var(--primary);
      letter-spacing: 0.05em;
    }

    .overview-box__text {
      font-size: 0.95rem;
      color: var(--text-main);
      font-weight: 500;
    }

    .overview-box__img {
      height: 3rem;
      width: 3rem;
      border-radius: 50%;
      margin-right: 1.2rem;
      object-fit: cover;
      border: 2px solid var(--primary);
    }

    .description-box {
      padding: 1rem 0;
    }

    .description__text {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .section-pictures {
      display: flex;
      clip-path: polygon(0 9vw, 100% 0, 100% calc(100% - 9vw), 0 100%);
      margin-top: -9vw;
      background-color: var(--bg-surface);
    }

    .picture-box {
      flex: 1;
      overflow: hidden;
      border-right: 1px solid var(--border);
    }

    .picture-box__img {
      display: block;
      width: 100%;
      height: 30rem;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .picture-box:hover .picture-box__img {
      transform: scale(1.08);
    }

    .section-map {
      position: relative;
      height: 40rem;
      margin-top: -9vw;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    #map {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 100%;
    }

    .section-reviews {
      margin-top: -9vw;
      padding: 12vw 0;
      background: linear-gradient(to right bottom, #0b0f19, #151c2c);
      clip-path: polygon(0 9vw, 100% 0, 100% calc(100% - 9vw), 0 100%);
    }

    .reviews {
      padding: 2rem 4rem;
      display: flex;
      gap: 2.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .reviews__card {
      width: 26rem;
      padding: 3rem;
      background-color: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      scroll-snap-align: center;
      flex-shrink: 0;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .reviews__card:hover {
      transform: translateY(-8px);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .reviews__avatar {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      margin-bottom: 1.5rem;
    }

    .reviews__avatar-img {
      height: 3.5rem;
      width: 3.5rem;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--primary);
    }

    .reviews__user {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .reviews__text {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .reviews__rating {
      display: flex;
      gap: 0.4rem;
    }

    .reviews__star {
      height: 1.2rem;
      width: 1.2rem;
    }

    .reviews__star--active {
      fill: var(--primary);
    }

    .reviews__star--inactive {
      fill: var(--border);
    }

    .section-cta {
      padding: 8rem 4rem;
      background-color: var(--bg-body);
    }

    .cta {
      position: relative;
      max-width: 70rem;
      margin: 0 auto;
      background-color: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 4.5rem 6rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      overflow: hidden;
    }

    .cta__img {
      height: 10rem;
      width: 10rem;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--primary);
    }

    .cta__img--logo {
      background: var(--bg-body);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .cta__img--logo img {
      width: 100%;
    }

    .cta__content {
      max-width: 35rem;
    }

    .cta__text {
      font-size: 1rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .btn--green {
      background-color: var(--primary);
      color: #042f2e;
      font-size: 0.95rem;
      text-transform: uppercase;
      padding: 1rem 2.5rem;
      border-radius: 99px;
      border: none;
      cursor: pointer;
      font-weight: 700;
      transition: all 0.2s ease;
    }

    .btn--green:hover {
      background-color: #34d399;
      transform: scale(1.03);
    }

block content
  mixin overviewBox(label, text, icon)
    .overview-box__detail
      svg.overview-box__icon
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      span.overview-box__label= label
      span.overview-box__text= text

  section.section-header
    .heading-box
      h1.heading-primary
        span= tour.name
      .heading-box__group
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-clock')
          span.heading-box__text= `${tour.duration} days`
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-map-pin')
          span.heading-box__text= tour.startLocation.description

  section.section-description
    .overview-box
      div
        .overview-box__group
          h2.heading-secondary.ma-bt-lg Quick facts
          +overviewBox('Next date', tour.startDate[0].toLocaleString('en-US', {month: 'long', year: 'numeric'}) , 'calendar')
          +overviewBox('Difficulty', tour.diffculty, 'trending-up')
          +overviewBox('Participants', `${tour.maxGroupSize} people`, 'user')
          +overviewBox('Rating', `${tour.ratingAverage} / 5`, 'star')

        .overview-box__group
          h2.heading-secondary.ma-bt-lg Your tour guides
          .overview-box__detail
            img.overview-box__img(src='/img/users/user-19.jpg', alt='Steven Miller')
            span.overview-box__label Lead guide
            span.overview-box__text Steven Miller
          .overview-box__detail
            img.overview-box__img(src='/img/users/user-18.jpg', alt='Lisa Brown')
            span.overview-box__label Tour guide
            span.overview-box__text Lisa Brown

    .description-box
      h2.heading-secondary.ma-bt-lg= `About ${tour.name}`
      p.description__text= tour.description
      
  section.section-pictures
    .picture-box
      img.picture-box__img.picture-box__img--1(src='/img/tours/tour-5-1.jpg', alt='Tour picture 1')
    .picture-box
      img.picture-box__img.picture-box__img--2(src='/img/tours/tour-5-2.jpg', alt='Tour picture 2')
    .picture-box
      img.picture-box__img.picture-box__img--3(src='/img/tours/tour-5-3.jpg', alt='Tour picture 3')

  section.section-map
    #map

  section.section-reviews
    .reviews
      each review in tour.reviews
        .reviews__card
          .reviews__avatar
            img.reviews__avatar-img(src=`/img/users/${review.user.photo}`, alt=`${review.user.name}`)
            p.reviews__text= review.user.name
          p.reviews__text= review.review
          .reviews__rating
          
            //Stars loop 
            each star in [1, 2, 3, 4, 5]
              svg.reviews__star(class=`reviews__star--${review.rating >= star ? 'active' : 'inactive'}`)
                use(xlink:href='/img/icons.svg#icon-star')

  section.section-cta
    .cta
      .cta__img.cta__img--logo
        img(src='/img/tour-logo-white.png', alt='Natours logo')
      img.cta__img.cta__img--1(src='/img/tours/tour-5-2.jpg', alt='Tour picture')
      img.cta__img.cta__img--2(src='/img/tours/tour-5-1.jpg', alt='Tour picture')

      .cta__content
        h2.heading-secondary What are you waiting for?
        p.cta__text 10 days. 1 adventure. Infinite memories. Make it yours today!
        button.btn.btn--green.span-all-rows Book tour now!