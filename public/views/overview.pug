extends base

block append head
  style.
    /* Main Layout - Fixed 2-by-2 Grid */
    .main {
      max-width: 1200px;
      margin: 3rem auto;
      padding: 0 2rem;
      flex: 1;
      width: 100%;
    }

    .card-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    @media (max-width: 850px) {
      .card-container {
        grid-template-columns: 1fr;
      }
    }

    /* Tour Cards */
    .card {
      background-color: var(--bg-surface);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      overflow: hidden;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-8px);
      border-color: rgba(16, 185, 129, 0.4);
      box-shadow: 0 25px 50px -12px var(--primary-glow);
    }

    .card__header {
      position: relative;
    }

    .card__picture {
      position: relative;
      height: 240px;
      overflow: hidden;
    }

    .card__picture-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .card:hover .card__picture-img {
      transform: scale(1.08);
    }

    .card__picture-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, var(--bg-surface) 0%, transparent 80%);
    }

    .heading-tertirary {
      position: absolute;
      bottom: 1.25rem;
      left: 1.5rem;
      right: 1.5rem;
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
    }

    .card__details {
      padding: 1.75rem;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      flex: 1;
    }

    .card__sub-heading {
      grid-column: 1 / -1;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--primary);
    }

    .card__text {
      grid-column: 1 / -1;
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .card__data {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.875rem;
      color: var(--text-main);
      font-weight: 500;
    }

    .card__icon {
      width: 18px;
      height: 18px;
      fill: var(--accent);
    }

    /* Card Footer */
    .card__footer {
      background-color: rgba(0, 0, 0, 0.2);
      padding: 1.5rem 1.75rem;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .card__footer-value {
      font-size: 1.25rem;
      font-weight: 800;
      color: #fff;
    }

    .card__footer-text {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      border-radius: 99px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.875rem;
      transition: all 0.2s ease;
    }

    .btn--green {
      background-color: var(--primary);
      color: #042f2e;
      box-shadow: 0 4px 14px var(--primary-glow);
    }

    .btn--green:hover {
      background-color: #34d399;
      transform: scale(1.03);
    }

block content
  mixin card(title, tourImageFilename, sub, text, location, date, stops, people, price, rating, reviews, detailsUrl)
    .card
      .card__header
        .card__picture
          .card__picture-overlay &nbsp;
          img.card__picture-img(src=`/img/tours/${tourImageFilename}`, alt=title)
        h3.heading-tertirary
          span= title

      .card__details
        h4.card__sub-heading= sub
        p.card__text= text
        .card__data
          svg.card__icon
            use(xlink:href="/img/icons.svg#icon-map-pin")
          span= location
        .card__data
          svg.card__icon
            use(xlink:href="/img/icons.svg#icon-calendar")
          span= date
        .card__data
          svg.card__icon
            use(xlink:href="/img/icons.svg#icon-flag")
          span= stops
        .card__data
          svg.card__icon
            use(xlink:href="/img/icons.svg#icon-user")
          span= people

      .card__footer
        p
          span.card__footer-value= price
          span.card__footer-text  per person
        p.card__ratings
          span.card__footer-value= rating
          span.card__footer-text= ` rating (${reviews})`
        a.btn.btn--green.btn--small(href=detailsUrl) Details

  main.main
    .card-container
      each tour in tours
        +card(
          tour.name,
          `./${tour.imageCover}`,
          `${tour.diffculty} ${tour.duration}-day tour`,
          `${tour.summary}`,
          `${tour.startLocation.description}`,
          `${tour.startDate[0].toLocaleString('en-US', {month: 'long', year: 'numeric'})}`,
          `${tour.totalStops} stops`,
          `${tour.maxGroupSize} people`,
          `$${tour.price}`,
          `${tour.ratingAverage.toFixed(1)}`,
          `${tour.ratingQuntity}`,
          `/tour/${tour.slug}`
        )